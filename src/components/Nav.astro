---
import { getEntry, getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import MapLines from './MapLines.astro';
import Destinations from './Destinations.astro';

interface Props {
  theme: 'overlay' | 'solid';
}

const { theme } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && path.startsWith(href);
---
<header class:list={['nav', `nav--${theme}`]} data-nav>
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label="Exploreans, home">
      <Wordmark class="nav__wordmark" decorative />
    </a>

    <nav class="nav__primary" aria-label="Main">
      <ul role="list" class="nav__links">
        {site.nav.map((item) => (
          <li class:list={['nav__item', { 'has-panel': item.href === '/places/' }]} data-panel-item={item.href === '/places/' ? '' : undefined}>
            <a class="nav__link label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
              {item.badge && <span class="soon">{item.badge}</span>}
            </a>
            {item.href === '/places/' && (
              <>
                <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="places-panel" data-panel-toggle>
                  <Icon name="caret-down" class="nav__caret" />
                  <span class="visually-hidden">Show the places</span>
                </button>
                <div class="panel" id="places-panel" data-panel>
                  <div class="panel__inner wrap">
                    <p class="panel__intro t-subhead">Wherever there is something real to explore.</p>
                    <ul role="list" class="panel__places">
                      {places.map((p) => (
                        <li class="panel__place" data-place={p.data.kind}>
                          <a href={`/places/#${p.id}`} class="panel__card">
                            <span class="panel__media">
                              <Img src={p.data.hero_image} alt="" sizes="360px" />
                            </span>
                            <span class="panel__text">
                              <span class="label label--place">{p.data.region}</span>
                              <span class="panel__name">{p.data.name}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <Destinations align="right" class="nav__dest" />

    <button class="nav__menu label" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span>Menu</span>
      <Icon name="list" class="nav__menu-icon" />
    </button>
  </div>
</header>

<dialog class="menu on-basalt" id="menu" aria-label="Menu" data-menu>
  <MapLines variant="c" tone="light" />
  <div class="menu__inner">
    <div class="menu__top">
      <a href="/" class="menu__brand" aria-label="Exploreans, home"><Wordmark class="menu__wordmark" decorative /></a>
      <button class="menu__close label" type="button" data-menu-close>
        <span>Close</span>
        <Icon name="x" class="nav__menu-icon" />
      </button>
    </div>
    <nav aria-label="Main">
      <ul role="list" class="menu__links">
        {site.nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} class="menu__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
              {item.badge && <span class="soon menu__soon">{item.badge}</span>}
            </a>
          </li>
        ))}
        <li style={`--i:${site.nav.length}`}>
          <a href="/about/" class="menu__link" aria-current={isCurrent('/about/') ? 'page' : undefined}>Our story</a>
        </li>
      </ul>
    </nav>
    <p class="label accent menu__places-title">{site.cta.label}</p>
    <ul role="list" class="menu__places">
      {places.map((p) => (
        <li data-place={p.data.kind}>
          <a href={p.data.website} class="menu__place" data-dest-link={p.data.name}>
            <span class="menu__bar" aria-hidden="true"></span>
            <span>
              <span class="label accent">{p.data.region}</span>
              <span class="menu__place-name">{p.data.name}</span>
            </span>
            <Icon name="arrow-up-right" class="menu__ext" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</dialog>

<script>
  import '../scripts/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const root = document.documentElement;

  // Solid from the moment the page moves, and always on screen so home is one click away
  const update = (y: number) => {
    nav.classList.toggle('is-solid', y > 4);
    nav.classList.toggle('is-compact', y > 24);
  };
  update(window.scrollY);
  ScrollTrigger.create({
    start: 0,
    end: 'max',
    onUpdate: (self) => update(self.scroll()),
  });

  // Places panel: hover on desktop, toggle button for keyboard and touch
  const item = nav.querySelector<HTMLElement>('[data-panel-item]');
  const toggle = nav.querySelector<HTMLButtonElement>('[data-panel-toggle]');
  if (item && toggle) {
    let closeTimer = 0;
    const setOpen = (open: boolean) => {
      window.clearTimeout(closeTimer);
      nav.classList.toggle('panel-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (canHover) {
      item.addEventListener('pointerenter', () => setOpen(true));
      item.addEventListener('pointerleave', () => {
        closeTimer = window.setTimeout(() => setOpen(false), 160);
      });
    }
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) setOpen(false);
    });
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // Mobile menu
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const open = () => {
    menu.showModal();
    root.classList.add('menu-open');
    window.__lenis?.stop();
    requestAnimationFrame(() => menu.classList.add('is-open'));
  };
  const close = () => {
    menu.classList.remove('is-open');
    root.classList.remove('menu-open');
    window.__lenis?.start();
    window.setTimeout(() => menu.close(), 320);
  };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  menu.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    color: var(--basalt);
    transition:
      transform 500ms var(--ease),
      background-color 450ms var(--ease),
      color 450ms var(--ease),
      box-shadow 450ms var(--ease);
  }

  .nav--overlay {
    color: var(--natural-white);
  }

  .nav--overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    background: linear-gradient(rgb(43 43 38 / 0.42), transparent);
    pointer-events: none;
    transition: opacity 450ms var(--ease);
  }

  .nav--solid,
  .nav.is-solid,
  .nav.panel-open {
    background: var(--natural-white);
    color: var(--basalt);
    box-shadow: 0 1px 0 var(--hairline);
  }

  .nav.is-solid::before,
  .nav.panel-open::before {
    opacity: 0;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--nav-h);
    transition: height 450ms var(--ease);
  }

  .nav.is-compact .nav__inner {
    height: var(--nav-h-compact);
  }

  .nav__brand {
    display: block;
    color: inherit;
    margin-right: auto;
    padding: 8px 0;
  }

  :global(.nav__wordmark) {
    width: 124px;
  }

  .nav__primary {
    display: none;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .nav__item {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding: 12px 0;
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
  }

  :global(.nav__caret) {
    width: 14px;
    height: 14px;
    transition: transform 450ms var(--ease);
  }

  .nav.panel-open :global(.nav__caret) {
    transform: rotate(180deg);
  }

  .nav :global(.nav__dest) {
    display: none;
  }

  .nav :global(.nav__dest .dest__btn) {
    min-height: 44px;
  }

  .nav--overlay:not(.is-solid):not(.panel-open) :global(.dest__btn) {
    --btn-bg: transparent;
    --btn-fg: var(--natural-white);
    --btn-border: color-mix(in srgb, var(--natural-white) 70%, transparent);
  }

  .nav--overlay:not(.is-solid):not(.panel-open) :global(.dest__btn:hover),
  .nav--overlay:not(.is-solid):not(.panel-open) :global(.dest.is-open .dest__btn) {
    --btn-bg: var(--natural-white);
    --btn-fg: var(--basalt);
    --btn-border: var(--natural-white);
  }

  .nav__menu {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 4px;
    background: none;
    border: 0;
  }

  :global(.nav__menu-icon) {
    width: 22px;
    height: 22px;
  }

  @media (min-width: 1024px) {
    :global(.nav__wordmark) {
      width: 136px;
    }

    .nav__primary {
      display: block;
    }

    .nav :global(.nav__dest) {
      display: inline-block;
    }

    .nav__menu {
      display: none;
    }
  }

  /* Places panel */
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--natural-white);
    color: var(--basalt);
    box-shadow: 0 1px 0 var(--hairline);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease),
      visibility 0s linear 400ms;
  }

  .nav.panel-open .panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease),
      visibility 0s;
  }

  .panel__inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--s-5);
    align-items: start;
    padding-block: var(--s-5) var(--s-6);
  }

  .panel__intro {
    max-width: 18ch;
  }

  .panel__places {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }

  .panel__card {
    display: grid;
    grid-template-columns: 148px 1fr;
    gap: var(--s-3);
    align-items: center;
    text-decoration: none;
    padding: 10px;
    margin: -10px;
    border-radius: var(--radius);
    transition: background-color 400ms var(--ease);
  }

  .panel__card:hover,
  .panel__card:focus-visible {
    background: var(--linen);
  }

  .panel__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    border-bottom: 4px solid var(--place);
  }

  .panel__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .panel__card:hover .panel__media :global(img) {
    transform: scale(1.05);
  }

  .panel__text {
    display: grid;
    gap: 6px;
  }

  .panel__name {
    font-size: var(--text-subhead);
    line-height: var(--leading-subhead);
  }

  /* Full-screen menu */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    min-height: 100%;
    padding: 0 var(--margin) var(--s-5);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
  }

  .menu__brand {
    color: inherit;
  }

  :global(.menu__wordmark) {
    width: 124px;
  }

  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    background: none;
    border: 0;
  }

  .menu__links {
    display: grid;
    gap: 4px;
    margin-top: var(--s-4);
  }

  .menu__link {
    display: inline-block;
    font-size: clamp(2.25rem, 9vw, 3.25rem);
    line-height: 1.15;
    text-decoration: none;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
    transition-delay: calc(80ms + var(--i) * 60ms);
  }

  .menu.is-open .menu__link {
    opacity: 1;
    transform: none;
  }

  .menu__soon {
    vertical-align: middle;
    margin-left: 12px;
  }

  .menu__link[aria-current='page'] {
    font-style: italic;
  }

  .menu__places-title {
    margin-top: auto;
    padding-top: var(--s-4);
    border-top: 1px solid rgb(250 250 245 / 0.18);
  }

  .menu__places {
    display: grid;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
  }

  .menu__place {
    display: grid;
    grid-template-columns: 4px 1fr 18px;
    gap: var(--s-3);
    align-items: center;
    text-decoration: none;
  }

  .menu__bar {
    align-self: stretch;
    border-radius: 2px;
    background: var(--place);
    box-shadow: 0 0 0 1px rgb(250 250 245 / 0.3);
  }

  .menu__place-name {
    display: block;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  :global(.menu__ext) {
    width: 18px;
    height: 18px;
  }

</style>
