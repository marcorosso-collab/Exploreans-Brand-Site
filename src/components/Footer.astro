---
import { getEntry, getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';
import MapLines from './MapLines.astro';
import Icon from './Icon.astro';

const site = (await getEntry('settings', 'site'))!.data;
const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="footer on-basalt">
  <MapLines variant="b" tone="light" lantern reveal />

  <div class="wrap footer__inner">
    <section class="footer__letter" aria-labelledby="newsletter-title">
      <h2 id="newsletter-title" class="t-headline footer__headline" data-reveal>{site.newsletter.headline}</h2>
      <div class="footer__form-wrap" data-reveal style="--i:1">
        <p class="t-lead muted">{site.newsletter.body}</p>
        <form
          class="footer__form"
          name="newsletter"
          method="POST"
          action="/thank-you/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-ajax-form
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="visually-hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label class="label footer__label" for="newsletter-email">Email address</label>
          <div class="footer__field">
            <input id="newsletter-email" type="email" name="email" required autocomplete="email" inputmode="email" />
            <button type="submit" class="btn btn--light">
              {site.newsletter.button}
              <Icon name="arrow-right" class="arrow" />
            </button>
          </div>
          <p class="footer__status" role="status" data-form-status data-success={site.newsletter.success}></p>
        </form>
      </div>
    </section>

    <div class="footer__sign">
      <Wordmark class="footer__wordmark" />
      <p class="footer__master">Explore beyond. Explore within.</p>
    </div>

    <div class="footer__cols">
      <nav aria-label="Explore">
        <h2 class="label accent">Explore</h2>
        <ul role="list">
          {site.nav.map((item) => (
            <li>
              <a class="link" href={item.href}>{item.label}</a>
              {item.badge && <span class="soon footer__soon">{item.badge}</span>}
            </li>
          ))}
          <li><a class="link" href="/about/">Our story</a></li>
        </ul>
      </nav>
      <nav aria-label="The places">
        <h2 class="label accent">The places</h2>
        <ul role="list">
          {places.map((p) => (
            <li data-place={p.data.kind}>
              <a class="footer__place" href={p.data.website} rel="noopener">
                <span class="footer__bar" aria-hidden="true"></span>
                <span><span class="link">{p.data.name}</span><span class="footer__region muted">{p.data.region}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Contact">
        <h2 class="label accent">Contact</h2>
        <ul role="list">
          {site.contacts.map((c) => <li><a class="link" href={c.href}>{c.label}</a></li>)}
          {site.social.map((c) => <li><a class="link" href={c.href} rel="noopener">{c.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer__base">
      <p class="data muted">{site.group_line}</p>
      <p class="data muted">&copy; {year} Exploreans</p>
    </div>
  </div>
</footer>

<script>
  // Netlify Forms over fetch, so guests stay on the page. Without JS the form posts normally.
  document.querySelectorAll<HTMLFormElement>('form[data-ajax-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      button?.setAttribute('disabled', '');
      form.setAttribute('aria-busy', 'true');
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('is-sent');
        if (status) status.textContent = status.dataset.success ?? 'Thank you.';
        form.reset();
      } catch {
        if (status) status.textContent = 'Something went wrong while sending. Please try again in a moment.';
        form.classList.add('has-error');
      } finally {
        button?.removeAttribute('disabled');
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .footer {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--s-6), 9vw, 136px) var(--s-5);
  }

  .footer__inner {
    position: relative;
    display: grid;
    gap: clamp(var(--s-6), 8vw, 120px);
  }

  .footer__letter {
    display: grid;
    gap: var(--s-5);
  }

  .footer__headline {
    max-width: 14ch;
  }

  .footer__form-wrap {
    display: grid;
    gap: var(--s-4);
    align-content: end;
  }

  .footer__form {
    display: grid;
    gap: var(--s-2);
  }

  .footer__label {
    color: var(--warm-ochre);
  }

  .footer__field {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
  }

  .footer__field input {
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid rgb(250 250 245 / 0.4);
    border-radius: var(--radius);
    background: transparent;
    color: var(--natural-white);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    transition: border-color var(--dur) var(--ease);
  }

  .footer__field input:hover {
    border-color: rgb(250 250 245 / 0.7);
  }

  .footer__field input:focus-visible {
    outline: 2px solid var(--natural-white);
    outline-offset: 2px;
    border-color: var(--natural-white);
  }

  .footer__status {
    min-height: 1.6em;
    color: var(--warm-ochre);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .footer__field {
      grid-template-columns: 1fr auto;
    }
  }

  @media (min-width: 1024px) {
    .footer__letter {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-6);
      align-items: end;
    }
  }

  .footer__sign {
    display: grid;
    justify-items: start;
    gap: 0;
  }

  :global(.footer__wordmark) {
    width: min(100%, 520px);
  }

  /* Master line below the wordmark, at least half the wordmark height away */
  .footer__master {
    margin-top: clamp(28px, 4vw, 56px);
    font-style: italic;
    font-size: var(--text-subhead);
    color: var(--warm-ochre);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--gutter);
    padding-top: var(--s-5);
    border-top: 1px solid rgb(250 250 245 / 0.16);
  }

  .footer__cols nav:nth-child(2) {
    grid-column: 1 / -1;
    order: -1;
  }

  @media (min-width: 768px) {
    .footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__cols nav:nth-child(2) {
      grid-column: auto;
      order: 0;
    }
  }

  .footer__cols h2 {
    margin-bottom: var(--s-3);
  }

  .footer__cols ul {
    display: grid;
    gap: 10px;
  }

  .footer__soon {
    margin-left: 10px;
    color: var(--warm-ochre);
  }

  .footer__place {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: 14px;
    text-decoration: none;
  }

  .footer__bar {
    border-radius: 2px;
    background: var(--place);
    box-shadow: 0 0 0 1px rgb(250 250 245 / 0.3);
  }

  .footer__region {
    display: block;
    font-size: 0.9375rem;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(250 250 245 / 0.16);
  }
</style>
