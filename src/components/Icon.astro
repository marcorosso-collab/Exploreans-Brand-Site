---
/** Phosphor icons (light weight), inlined at build time. One family for the whole site. */
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'list' | 'x' | 'play' | 'pause' | 'caret-down' | 'check' | 'envelope-simple';
  class?: string;
  size?: number;
}

const { name, class: className = 'icon', size } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(`@phosphor-icons/core/assets/light/${name}-light.svg`);
const svg = readFileSync(file, 'utf8').replace(
  '<svg ',
  `<svg class="${className}" aria-hidden="true" focusable="false"${size ? ` width="${size}" height="${size}"` : ''} `,
);
---
<Fragment set:html={svg} />
