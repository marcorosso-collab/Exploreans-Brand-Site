---
import { getEntry } from 'astro:content';
import Img from '../Img.astro';
import MapLines from '../MapLines.astro';

const { pillars } = (await getEntry('home', 'home'))!.data;
---
<section class="pillars on-basalt section" aria-labelledby="pillars-title" data-pillars>
  <MapLines variant="c" tone="light" lantern />

  <div class="wrap pillars__grid">
    <div class="pillars__aside">
      <div class="pillars__sticky">
        <p class="pillars__a3" aria-hidden="true">A<sup>3</sup></p>
        <h2 id="pillars-title" class="t-headline pillars__formula">
          {pillars.items.map((item, i) => (
            <>
              <span class="pillars__word" data-word={i}>{item.name}</span>
              {i < pillars.items.length - 1 && <span class="pillars__times" aria-hidden="true"> &times; </span>}
            </>
          ))}
        </h2>
        <p class="muted pillars__intro">{pillars.intro}</p>
        <p class="pillars__closing" data-reveal>
          <span class="a3 accent" aria-label="A-cubed">A<sup>3</sup></span>
          <span class="t-quote">{pillars.closing}</span>
        </p>
      </div>
    </div>

    <ol class="pillars__list" role="list">
      {pillars.items.map((item, i) => (
        <li class="pillar" data-pillar={i}>
          <div class="pillar__media" data-clip>
            <Img src={item.image} alt={item.alt} sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
          <div class="pillar__text" data-reveal-group>
            <p class="label accent" data-reveal>{item.label}</p>
            <h3 class="t-headline" data-reveal>{item.name}</h3>
            <p class="t-lead pillar__body" data-reveal>{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

</section>

<script>
  import '../../scripts/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector<HTMLElement>('[data-pillars]');
  if (root) {
    const words = root.querySelectorAll<HTMLElement>('[data-word]');
    words[0]?.classList.add('is-on');
    root.querySelectorAll<HTMLElement>('[data-pillar]').forEach((pillar) => {
      ScrollTrigger.create({
        trigger: pillar,
        start: 'top 60%',
        end: 'bottom 60%',
        onToggle(self) {
          if (!self.isActive) return;
          words.forEach((w) => w.classList.toggle('is-on', w.dataset.word === pillar.dataset.pillar));
        },
      });
    });
    // Once past the last pillar, all three are lit: multiplied
    ScrollTrigger.create({
      trigger: root.querySelector('.pillars__list')!,
      start: 'bottom 60%',
      onEnter: () => words.forEach((w) => w.classList.add('is-on')),
      onLeaveBack: () => words.forEach((w, i) => w.classList.toggle('is-on', i === words.length - 1)),
    });
  }
</script>

<style>
  .pillars {
    overflow: clip;
  }

  .pillars__grid {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }

  .pillars__sticky {
    display: grid;
    gap: var(--s-4);
  }

  /* A³ set in Georgia Regular, the 3 a true superscript at about 45%, top aligned */
  .pillars__a3 {
    font-size: clamp(7rem, 4rem + 14vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--natural-white);
  }

  .pillars__a3 sup {
    font-size: 0.45em;
    vertical-align: 0;
    position: relative;
    top: -0.92em;
    margin-left: 0.03em;
  }

  .pillars__formula {
    max-width: 16ch;
  }

  .pillars__word {
    transition: color 600ms var(--ease);
    color: rgb(250 250 245 / 0.6);
  }

  :global(html:not(.js)) .pillars__word,
  .pillars__word.is-on {
    color: var(--natural-white);
  }

  .pillars__times {
    color: var(--warm-ochre);
  }

  .pillars__intro {
    max-width: 34ch;
  }

  .pillars__closing {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: var(--s-3);
  }

  .pillars__closing .a3 {
    font-size: var(--text-quote);
  }

  .pillars__list {
    display: grid;
    gap: clamp(var(--s-6), 10vw, 160px);
    padding: 0;
    margin: 0;
  }

  .pillar {
    display: grid;
    gap: var(--s-4);
  }

  .pillar__media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .pillar:nth-child(2) .pillar__media {
    aspect-ratio: 4 / 5;
    width: 82%;
    margin-left: auto;
  }

  .pillar__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pillar__text {
    display: grid;
    gap: 10px;
  }

  .pillar__body {
    max-width: 34ch;
    color: rgb(250 250 245 / 0.86);
  }

  @media (min-width: 1024px) {
    .pillars__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-7);
    }

    .pillars__sticky {
      position: sticky;
      top: calc(var(--nav-h-compact) + 48px);
    }

    .pillars__aside {
      height: 100%;
    }
  }

</style>
