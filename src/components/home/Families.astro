---
import { getEntry, getCollection } from 'astro:content';
import Img from '../Img.astro';
import Icon from '../Icon.astro';
import Stamp from '../Stamp.astro';
import { stampsForFamily, stampLabel, type FamilyId } from '../../lib/stamps';

const home = (await getEntry('home', 'home'))!.data;
const families = (await getCollection('families')).sort((a, b) => a.data.order - b.data.order);
---
<section class="families on-linen" aria-labelledby="families-title" data-families>
  <div class="families__pin" data-families-pin>
    <div class="families__track" data-families-track>
      <div class="families__intro">
        <h2 id="families-title" class="t-headline">{home.families.headline}</h2>
        <div class="families__key" aria-hidden="true">
          <span class="families__key-beyond label">Explore beyond</span>
          <span class="families__key-within label">Explore within</span>
        </div>
      </div>

      {families.map((f) => (
        <article class:list={['family', `family--${f.data.direction}`]} aria-labelledby={`family-${f.id}`}>
          <div class="family__media">
            <Img src={f.data.image} alt={f.data.alt} sizes="(min-width: 1024px) 34vw, 82vw" />
          </div>
          <div class="family__body">
            <p class="label family__direction">{f.data.direction === 'beyond' ? 'Explore beyond' : 'Explore within'}</p>
            <h3 id={`family-${f.id}`} class="t-headline">{f.data.name}</h3>
            <p class="family__summary">{f.data.summary}</p>
            <ul role="list" class="family__stamps">
              {stampsForFamily(f.id as FamilyId).map((s, j) => (
                <li style={`--j:${j}`}>
                  <Stamp id={s} size={52} decorative ink />
                  <span class="family__stamp-name">{stampLabel(s)}</span>
                </li>
              ))}
            </ul>
            <a href={`/experiences/?family=${f.id}`} class="link-arrow family__link">
              {f.data.name} experiences <Icon name="arrow-right" />
            </a>
          </div>
        </article>
      ))}

      <div class="families__end">
        <p class="t-subhead">{home.families.closing}</p>
        <a href="/experiences/" class="btn">Browse every experience <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { reduceMotion } from '../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-families]');
  if (section && !reduceMotion) {
    const pin = section.querySelector<HTMLElement>('[data-families-pin]')!;
    const track = section.querySelector<HTMLElement>('[data-families-track]')!;
    const mm = gsap.matchMedia();
    // Pinned horizontal travel on wide screens; touch devices keep native swiping
    mm.add('(min-width: 1024px) and (hover: hover)', () => {
      section.classList.add('is-pinned');
      const distance = () => track.scrollWidth - window.innerWidth;
      gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });
      return () => section.classList.remove('is-pinned');
    });
  }
</script>

<style>
  .families {
    position: relative;
    overflow: clip;
  }

  .families__pin {
    padding-block: clamp(var(--s-6), 9vw, 136px);
  }

  .families__track {
    display: flex;
    gap: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margin);
    padding-inline: var(--margin);
    padding-bottom: var(--s-3);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .families__track::-webkit-scrollbar {
    display: none;
  }

  .families__intro,
  .family,
  .families__end {
    flex: none;
    scroll-snap-align: start;
  }

  .families__intro {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    width: min(84vw, 420px);
    padding-right: var(--s-4);
  }

  .families__key {
    display: flex;
    margin-top: var(--s-3);
  }

  /* As in the bible: a Linen band for Explore beyond, a Basalt band for Explore within */
  .families__key-beyond,
  .families__key-within {
    padding: 10px 12px;
    white-space: nowrap;
  }

  .families__key-beyond {
    flex: 2.4;
    background: var(--natural-white);
    border: 1px solid var(--hairline);
    border-right: 0;
  }

  .families__key-within {
    flex: 1;
    background: var(--basalt);
    color: var(--natural-white);
    white-space: nowrap;
  }

  .family {
    display: grid;
    grid-template-rows: auto 1fr;
    width: min(82vw, 380px);
    background: var(--natural-white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .family--within {
    background: var(--basalt);
    color: var(--natural-white);
    border-color: var(--basalt);
  }

  .family__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .family__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1400ms var(--ease-out);
  }

  .family:hover .family__media :global(img) {
    transform: scale(1.05);
  }

  .family__body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: var(--s-4);
  }

  .family__direction {
    color: var(--stone);
  }

  .family--within .family__direction {
    color: var(--warm-ochre);
  }

  .family__summary {
    color: var(--stone);
  }

  .family--within .family__summary {
    color: rgb(250 250 245 / 0.82);
  }

  .family__stamps {
    display: flex;
    gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-2);
  }

  .family__stamps li {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 72px;
    text-align: center;
  }

  .family__stamp-name {
    font-family: var(--font-label);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .family__link {
    justify-self: start;
    margin-top: auto;
  }

  .families__end {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s-4);
    width: min(82vw, 380px);
    padding: var(--s-4);
  }

  /* Ink */
  .family :global([data-stamp-ink]) {
    opacity: 0;
    transform: scale(1.35) rotate(-10deg);
    filter: blur(2px);
  }

  .family :global([data-stamp-ink].is-inked) {
    opacity: 1;
    transform: scale(1) rotate(calc(-3deg + var(--j) * 3deg));
    filter: none;
    transition:
      opacity 450ms var(--ease-out),
      transform 450ms var(--ease-out),
      filter 450ms var(--ease-out);
    transition-delay: calc(var(--j) * 140ms + 120ms);
  }

  :global(html:not(.js)) .family :global([data-stamp-ink]) {
    opacity: 1;
    transform: none;
    filter: none;
  }

  @media (min-width: 1024px) {
    .families.is-pinned .families__pin {
      height: 100vh;
      display: flex;
      align-items: center;
      padding-block: 0;
    }

    .families.is-pinned .families__track {
      overflow: visible;
      scroll-snap-type: none;
      padding-right: var(--margin);
      gap: var(--s-5);
      align-items: center;
    }

    .families__intro {
      width: 440px;
    }

    .family,
    .families__end {
      width: 400px;
    }

    .family:nth-of-type(even) {
      transform: translateY(32px);
    }
  }

  @media (min-width: 1024px) and (max-height: 820px) {
    .family__media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .family :global([data-stamp-ink]) {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
