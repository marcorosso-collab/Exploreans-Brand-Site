---
import { getEntry } from 'astro:content';
import Img from '../Img.astro';

const { idea } = (await getEntry('home', 'home'))!.data;
// Beyond is the wide landscape frame, Within the tall portrait: the layout follows the photographs
const sides = [
  { key: 'beyond', sizes: '(min-width: 700px) 58vw, 100vw', ...idea.beyond },
  { key: 'within', sizes: '(min-width: 700px) 34vw, 100vw', ...idea.within },
];
---
<section class="idea section section--tight" aria-labelledby="idea-title">
  <div class="wrap">
    <h2 id="idea-title" class="t-headline idea__title" data-reveal>{idea.headline}</h2>
    <div class="idea__pair">
      {sides.map((side) => (
        <article class:list={['idea__side', `idea__side--${side.key}`]}>
          <div class="idea__media" data-clip>
            <Img src={side.image} alt={side.alt} sizes={side.sizes} />
          </div>
          <div class="idea__text" data-reveal-group>
            <p class="label" data-reveal>{side.label}</p>
            <h3 class="t-subhead" data-reveal>{side.title}</h3>
            <p class="muted measure" data-reveal>{side.body}</p>
            <p class="idea__example" data-reveal>&ldquo;{side.example}&rdquo;</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .idea__title {
    max-width: 16ch;
    margin-bottom: var(--s-6);
  }

  .idea__pair {
    display: grid;
    gap: var(--s-6);
  }

  .idea__side {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .idea__media {
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
  }

  .idea__side--within .idea__media {
    aspect-ratio: 4 / 5;
  }

  .idea__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .idea__text {
    display: grid;
    gap: 10px;
    max-width: 46ch;
  }

  .idea__example {
    margin-top: var(--s-2);
    padding-left: var(--s-3);
    border-left: 1px solid var(--warm-ochre);
    font-style: italic;
  }

  @media (min-width: 700px) {
    .idea__pair {
      grid-template-columns: 6fr 1fr 5fr;
    }

    .idea__side--beyond {
      grid-column: 1;
    }

    /* Within is the narrower, taller frame and sits lower: the two directions never mirror each other */
    .idea__side--within {
      grid-column: 3;
      margin-top: clamp(80px, 12vw, 180px);
    }
  }

  @media (min-width: 1024px) {
    .idea__pair {
      grid-template-columns: 7fr 1fr 4fr;
    }
  }
</style>
