---
import { getEntry } from 'astro:content';
import Img from '../Img.astro';

const { moment } = (await getEntry('home', 'home'))!.data;
---
<section class="moment" aria-label="A moment at Mara River Camp">
  <figure class="moment__frame" data-moment>
    <Img src={moment.image} alt={moment.alt} class="moment__img" />
    <figcaption class="moment__text wrap">
      <span class="moment__line">{moment.line}</span>
      <span class="label moment__place">{moment.place}</span>
    </figcaption>
  </figure>
</section>

<script>
  import { gsap } from 'gsap';
  import { reduceMotion } from '../../scripts/motion';

  // The frame opens from a framed photograph to the full width of the page
  const frame = document.querySelector<HTMLElement>('[data-moment]');
  if (frame && !reduceMotion) {
    const img = frame.querySelector('img');
    const tl = gsap.timeline({
      scrollTrigger: { trigger: frame, start: 'top 85%', end: 'top 15%', scrub: 0.6 },
    });
    tl.fromTo(frame, { clipPath: 'inset(0% 14% 0% 14% round 6px)' }, { clipPath: 'inset(0% 0% 0% 0% round 0px)', ease: 'none' }, 0);
    tl.fromTo(img, { scale: 1.18 }, { scale: 1, ease: 'none' }, 0);
    tl.fromTo(frame.querySelector('.moment__text'), { opacity: 0, y: 24 }, { opacity: 1, y: 0, ease: 'none' }, 0.45);
  }
</script>

<style>
  .moment__frame {
    position: relative;
    height: min(92vh, 880px);
    min-height: 520px;
    overflow: hidden;
    color: var(--natural-white);
  }

  .moment__frame :global(.moment__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .moment__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(43 43 38 / 0.62), rgb(43 43 38 / 0.1) 60%);
  }

  .moment__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: var(--s-3);
    padding-bottom: clamp(var(--s-5), 6vw, var(--s-6));
  }

  .moment__line {
    max-width: 20ch;
    font-size: clamp(2rem, 1.3rem + 2.8vw, 4rem);
    line-height: 1.12;
    font-style: italic;
    text-wrap: balance;
  }

  .moment__place {
    color: rgb(250 250 245 / 0.86);
  }
</style>
