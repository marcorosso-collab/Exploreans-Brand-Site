---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import MapLines from '../../components/MapLines.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import Destinations from '../../components/Destinations.astro';

const page = (await getEntry('about', 'about'))!.data;
const home = (await getEntry('home', 'home'))!.data;
---
<Base title={page.seo_title} description={page.seo_description} ogImage={page.image}>
  <PageHeader title={page.title} lead={page.lead} image={page.image} alt={page.alt} kicker="Our story" />

  <section class="section conviction" aria-labelledby="conviction-title">
    <div class="wrap">
      <div class="conviction__card on-basalt" data-reveal>
        <MapLines variant="b" tone="light" lantern />
        <p class="label conviction__label">Our conviction</p>
        <h2 id="conviction-title" class="t-display conviction__title">{page.conviction.title}</h2>
        <p class="t-lead conviction__body">{page.conviction.body}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight idea" aria-labelledby="idea-title">
    <div class="wrap idea__grid">
      <h2 id="idea-title" class="t-headline" data-reveal>Explore beyond. Explore within.</h2>
      <div class="idea__cols">
        {[home.idea.beyond, home.idea.within].map((side) => (
          <div class="idea__col" data-reveal>
            <p class="label">{side.label}</p>
            <h3 class="t-subhead">{side.title}</h3>
            <p class="muted">{side.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section pillars on-linen" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="pillars__head" data-reveal-group>
        <p class="pillars__formula t-headline" data-reveal>Adventure &times; Awe &times; Authentic</p>
        <h2 id="pillars-title" class="pillars__a3" data-reveal>
          <span class="a3" aria-label="A-cubed">A<sup>3</sup></span>
        </h2>
        <p class="t-quote" data-reveal>{home.pillars.closing}</p>
      </div>
      <ol class="pillars__list" role="list" data-reveal-group>
        {home.pillars.items.map((item) => (
          <li class="pillar" data-reveal>
            <p class="label muted">{item.label}</p>
            <h3 class="t-headline">{item.name}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section explorean" aria-labelledby="explorean-title">
    <div class="wrap explorean__grid">
      <figure class="explorean__media" data-clip>
        <Img src={page.explorean.image} alt={page.explorean.alt} sizes="(min-width: 1024px) 40vw, 100vw" />
      </figure>
      <div class="explorean__text">
        <h2 id="explorean-title" class="t-headline" data-reveal>{page.explorean.headline}</h2>
        <ul role="list" class="explorean__types" data-reveal-group>
          {page.explorean.types.map((t) => (
            <li data-reveal>
              <h3 class="t-subhead">{t.name}</h3>
              <p class="muted">{t.body}</p>
            </li>
          ))}
        </ul>
        <p class="t-quote explorean__closing" data-reveal>{page.explorean.closing}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight promise" aria-labelledby="promise-title">
    <div class="wrap">
      <h2 id="promise-title" class="t-headline promise__title" data-reveal>{page.promise.headline}</h2>
      <dl class="promise__list" data-reveal-group>
        {page.promise.items.map((item) => (
          <div class="promise__item" data-reveal>
            <dt class="t-subhead">{item.name}</dt>
            <dd class="muted">{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="test" class="section test on-basalt" aria-labelledby="test-title">
    <MapLines variant="a" tone="light" reveal />
    <div class="wrap test__grid">
      <div class="test__head" data-reveal-group>
        <p class="label accent" data-reveal>The Exploreans test</p>
        <h2 id="test-title" class="t-headline" data-reveal>{page.test.headline}</h2>
        <p class="muted" data-reveal>{page.test.body}</p>
      </div>
      <ol class="test__list" role="list">
        {page.test.questions.map((q, i) => (
          <li class="test__q" data-reveal style={`--i:${i % 3}`}>
            <span class="test__n data accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="test__name t-subhead">{q.name}</span>
            <span class="test__question muted">{q.question}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight about-cta">
    <div class="wrap about-cta__inner" data-reveal-group>
      <p class="t-headline" data-reveal>Two places to begin.</p>
      <div class="about-cta__actions" data-reveal>
        <Destinations direction="up" />
        <a href="/experiences/" class="btn btn--outline">See the experiences <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .conviction__card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--s-4);
    padding: clamp(var(--s-5), 7vw, var(--s-7));
    border-radius: var(--radius);
  }

  .conviction__label,
  .conviction__title,
  .conviction__body {
    position: relative;
  }

  .conviction__label {
    color: rgb(250 250 245 / 0.6);
  }

  .conviction__title {
    font-style: italic;
    color: var(--warm-ochre);
    max-width: 16ch;
    padding-bottom: 0.05em;
  }

  .conviction__body {
    max-width: 48ch;
    color: rgb(250 250 245 / 0.88);
  }

  .idea__grid {
    display: grid;
    gap: var(--s-5);
  }

  .idea__cols {
    display: grid;
    gap: var(--s-5) var(--gutter);
  }

  @media (min-width: 768px) {
    .idea__cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1200px) {
    .idea__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  .idea__col {
    display: grid;
    gap: 10px;
    padding-top: var(--s-3);
    border-top: 1px solid var(--basalt);
  }

  .pillars__head {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }

  .pillars__a3 {
    font-size: clamp(6rem, 4rem + 10vw, 12rem);
    line-height: 0.9;
    font-weight: 400;
  }

  .pillars__a3 :global(sup) {
    top: -0.92em;
  }

  .pillars__list {
    display: grid;
    gap: var(--s-5) var(--gutter);
  }

  @media (min-width: 900px) {
    .pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pillar:nth-child(2) {
      margin-top: var(--s-6);
    }

    .pillar:nth-child(3) {
      margin-top: calc(var(--s-6) * 2);
    }
  }

  .pillar {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: var(--s-3);
    border-top: 1px solid var(--basalt);
  }

  .explorean__grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .explorean__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--s-7);
    }
  }

  .explorean__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .explorean__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .explorean__text {
    display: grid;
    gap: var(--s-5);
  }

  .explorean__types {
    display: grid;
  }

  .explorean__types li {
    display: grid;
    gap: 4px;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--hairline);
  }

  .explorean__closing {
    color: var(--basalt);
  }

  .promise__title {
    max-width: 16ch;
    margin-bottom: var(--s-6);
  }

  .promise__list {
    display: grid;
    gap: var(--s-5) var(--gutter);
  }

  @media (min-width: 700px) {
    .promise__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .promise__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .promise__item {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .promise__item dd {
    margin: 0;
    max-width: 36ch;
  }

  .test {
    overflow: clip;
    scroll-margin-top: var(--nav-h-compact);
  }

  .test__grid {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 1100px) {
    .test__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }

    .test__head {
      position: sticky;
      top: calc(var(--nav-h-compact) + var(--s-5));
    }
  }

  .test__head {
    display: grid;
    gap: var(--s-4);
    max-width: 44ch;
  }

  .test__list {
    display: grid;
  }

  .test__q {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 6px var(--s-3);
    padding-block: var(--s-4);
    border-bottom: 1px solid rgb(250 250 245 / 0.16);
  }

  .test__q:first-child {
    border-top: 1px solid rgb(250 250 245 / 0.16);
  }

  .test__n {
    grid-row: span 2;
    padding-top: 0.4em;
  }

  .test__question {
    font-size: 1.0625rem;
  }

  .about-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
