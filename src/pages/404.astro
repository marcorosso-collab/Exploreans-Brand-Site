---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Off the map | Exploreans" description="This page has moved or the address has changed." navTheme="solid">
  <meta slot="head" name="robots" content="noindex" />
  <PageHeader title="Off the map." lead="This page has moved, or the address has changed. Every good explorer takes a wrong turn now and then." map="c">
    <div class="actions">
      <a href="/" class="btn">Back to the start <Icon name="arrow-right" class="arrow" /></a>
      <a href="/places/" class="btn btn--outline">See the places</a>
    </div>
  </PageHeader>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--s-3);
  }
</style>
