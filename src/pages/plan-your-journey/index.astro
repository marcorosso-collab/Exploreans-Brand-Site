---
import { getEntry, getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import Stamp from '../../components/Stamp.astro';
import { FAMILIES, FAMILY_NAMES, stampsForFamily } from '../../lib/stamps';

const page = (await getEntry('plan', 'plan'))!.data;
const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
---
<Base title={page.seo_title} description={page.seo_description} navTheme="solid">
  <div class="plan wrap">
    <aside class="plan__aside">
      <div class="plan__sticky">
        <figure class="plan__media" data-clip>
          <Img src={page.image} alt={page.alt} sizes="(min-width: 1024px) 40vw, 100vw" priority />
        </figure>
        <ul role="list" class="plan__places">
          {places.map((p) => (
            <li data-place={p.data.kind} class="plan__place">
              <span class="plan__bar" aria-hidden="true"></span>
              <div>
                <p class="label label--place">{p.data.region}</p>
                <p class="t-subhead">{p.data.name}</p>
                <p class="plan__links data">
                  {p.data.booking_url && <a class="link" href={p.data.booking_url} rel="noopener">Book online</a>}
                  {p.data.email && <a class="link" href={`mailto:${p.data.email}`}>{p.data.email}</a>}
                  {p.data.phone && <a class="link" href={`tel:${p.data.phone.replace(/\s/g, '')}`}>{p.data.phone}</a>}
                  <a class="link" href={p.data.website} rel="noopener">{p.data.website_label}</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <div class="plan__main">
      <header class="plan__head" data-intro data-reveal-group>
        <h1 class="t-display" data-reveal style="--i:0">{page.title}</h1>
        <p class="t-lead muted" data-reveal style="--i:1">{page.lead}</p>
      </header>

      <form
        class="form"
        name="enquiry"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        data-enquiry
      >
        <input type="hidden" name="form-name" value="enquiry" />
        <p class="visually-hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset class="form__set">
          <legend class="t-subhead">{page.form_title}</legend>

          <div class="field">
            <span class="label field__label" id="place-label">Where would you like to go</span>
            <div class="choices" role="radiogroup" aria-labelledby="place-label">
              {places.map((p, i) => (
                <label class="choice" data-place={p.data.kind}>
                  <input type="radio" name="place" value={p.data.name} data-place-id={p.id} checked={i === 0} />
                  <span class="choice__box">
                    <span class="choice__bar" aria-hidden="true"></span>
                    <span>{p.data.name}</span>
                  </span>
                </label>
              ))}
              <label class="choice">
                <input type="radio" name="place" value="Both places" data-place-id="both" />
                <span class="choice__box"><span>Both places</span></span>
              </label>
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label class="label field__label" for="arrival">Arrival date</label>
              <input id="arrival" name="arrival" type="date" class="input" />
            </div>
            <div class="field">
              <label class="label field__label" for="nights">Nights</label>
              <input id="nights" name="nights" type="number" min="1" max="60" inputmode="numeric" class="input" placeholder="For example, 4" />
            </div>
          </div>

          <div class="form__row">
            <div class="field">
              <label class="label field__label" for="adults">Adults</label>
              <input id="adults" name="adults" type="number" min="1" max="30" value="2" inputmode="numeric" class="input" />
            </div>
            <div class="field">
              <label class="label field__label" for="children">Children</label>
              <input id="children" name="children" type="number" min="0" max="20" value="0" inputmode="numeric" class="input" />
            </div>
          </div>

          <div class="field">
            <span class="label field__label" id="families-label">What would you like to explore</span>
            <div class="choices choices--families" role="group" aria-labelledby="families-label">
              {FAMILIES.map((f) => (
                <label class="choice">
                  <input type="checkbox" name="families" value={FAMILY_NAMES[f]} />
                  <span class="choice__box">
                    <Stamp id={stampsForFamily(f)[0]} size={26} decorative />
                    <span>{FAMILY_NAMES[f]}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>
        </fieldset>

        <fieldset class="form__set">
          <legend class="t-subhead">Your details</legend>
          <div class="form__row">
            <div class="field">
              <label class="label field__label" for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" class="input" aria-describedby="name-error" />
              <p class="field__error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label class="label field__label" for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" class="input" aria-describedby="email-error" />
              <p class="field__error" id="email-error" data-error-for="email"></p>
            </div>
          </div>
          <div class="field">
            <label class="label field__label" for="phone">Phone <span class="field__optional">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class="input" />
          </div>
          <div class="field">
            <label class="label field__label" for="message">Anything else we should know <span class="field__optional">(optional)</span></label>
            <textarea id="message" name="message" rows="5" class="input input--area"></textarea>
          </div>
          <div class="field">
            <label class="check">
              <input type="checkbox" name="consent" value="yes" required aria-describedby="consent-error" />
              <span>{page.consent}</span>
            </label>
            <p class="field__error" id="consent-error" data-error-for="consent"></p>
          </div>
        </fieldset>

        <div class="form__submit">
          <button type="submit" class="btn">{page.button} <Icon name="arrow-right" class="arrow" /></button>
          <p class="form__status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>

      <div class="sent" hidden data-sent tabindex="-1">
        <p class="t-headline">{page.success_title}</p>
        <p class="t-lead muted">{page.success_body}</p>
        <a href="/stories/" class="link-arrow">Read the stories <Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  if (form) {
    const sent = document.querySelector<HTMLElement>('[data-sent]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    // Arriving from a place page selects that place
    const wanted = new URLSearchParams(location.search).get('place');
    if (wanted) {
      const radio = form.querySelector<HTMLInputElement>(`input[data-place-id="${CSS.escape(wanted)}"]`);
      if (radio) radio.checked = true;
    }

    const arrival = form.querySelector<HTMLInputElement>('#arrival')!;
    arrival.min = new Date().toISOString().slice(0, 10);

    const messages: Record<string, string> = {
      name: 'Please add your name.',
      email: 'Please add an email address we can reply to.',
      consent: 'Please confirm we may use your details to reply.',
    };

    const validate = () => {
      let first: HTMLInputElement | null = null;
      for (const key of Object.keys(messages)) {
        const input = form.querySelector<HTMLInputElement>(`[name="${key}"]`)!;
        const error = form.querySelector<HTMLElement>(`[data-error-for="${key}"]`)!;
        const ok = input.type === 'checkbox' ? input.checked : input.checkValidity() && input.value.trim() !== '';
        input.toggleAttribute('aria-invalid', !ok);
        if (!ok) input.setAttribute('aria-invalid', 'true');
        error.textContent = ok ? '' : key === 'email' && input.value ? 'That email address looks incomplete.' : messages[key];
        if (!ok && !first) first = input;
      }
      return first;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = validate();
      if (invalid) {
        invalid.focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.textContent = 'Sending your enquiry';
      try {
        const data = new FormData(form);
        const body = new URLSearchParams();
        data.forEach((value, key) => key !== 'families' && body.append(key, String(value)));
        body.set('families', data.getAll('families').join(', '));
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        sent.hidden = false;
        sent.focus();
        window.dataLayer?.push({ event: 'enquiry_submitted', place: data.get('place') });
      } catch {
        status.textContent = 'Something went wrong while sending. Please try again, or write to the place directly.';
      } finally {
        button.disabled = false;
      }
    });
  }

  declare global {
    interface Window {
      dataLayer?: Record<string, unknown>[];
    }
  }
</script>

<style>
  .plan {
    /* Field outlines need 3:1 against white to be seen (WCAG 1.4.11) */
    --field-border: color-mix(in srgb, var(--stone) 78%, #fff);
    display: grid;
    gap: var(--s-6);
    padding-top: calc(var(--nav-h) + var(--s-5));
    padding-bottom: clamp(var(--s-6), 9vw, 152px);
  }

  .plan__main {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .plan__head {
    display: grid;
    gap: var(--s-4);
    max-width: 40ch;
  }

  .plan__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .plan__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plan__places {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }

  .plan__place {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: var(--s-3);
  }

  .plan__bar {
    border-radius: 2px;
    background: var(--place);
  }

  .plan__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 6px;
  }

  @media (min-width: 1024px) {
    .plan {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-7);
      padding-top: calc(var(--nav-h) + var(--s-6));
    }

    .plan__aside {
      order: 2;
    }

    .plan__sticky {
      position: sticky;
      top: calc(var(--nav-h-compact) + var(--s-4));
    }

    .plan__main {
      order: 1;
    }
  }

  .form {
    display: grid;
    gap: var(--s-6);
  }

  .form__set {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .form__set legend {
    padding: 0;
    margin-bottom: var(--s-2);
  }

  .form__row {
    display: grid;
    gap: var(--s-4) var(--gutter);
  }

  @media (min-width: 640px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field__label {
    color: var(--basalt);
  }

  .field__optional {
    color: var(--stone);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.875rem;
  }

  .input {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--basalt);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    transition: border-color var(--dur) var(--ease);
  }

  .input::placeholder {
    color: var(--stone);
  }

  .input:hover {
    border-color: var(--stone);
  }

  .input:focus-visible {
    outline: 2px solid var(--basalt);
    outline-offset: 1px;
    border-color: var(--basalt);
  }

  .input[aria-invalid='true'] {
    border-color: var(--vintage);
  }

  .input--area {
    resize: vertical;
    min-height: 140px;
  }

  .field__error {
    min-height: 0;
    color: var(--vintage);
    font-size: 0.9375rem;
  }

  .field__error:empty {
    display: none;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .choice {
    position: relative;
    cursor: pointer;
  }

  .choice input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .choice__box {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    background: #fff;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .choice:hover .choice__box {
    border-color: var(--basalt);
  }

  .choice input:checked + .choice__box {
    background: var(--basalt);
    border-color: var(--basalt);
    color: var(--natural-white);
  }

  .choice input:focus-visible + .choice__box {
    outline: 2px solid var(--basalt);
    outline-offset: 2px;
  }

  .choice__bar {
    width: 4px;
    height: 20px;
    border-radius: 2px;
    background: var(--place);
  }

  .check {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    cursor: pointer;
    font-size: 1rem;
  }

  .check input {
    width: 20px;
    height: 20px;
    margin: 3px 0 0;
    accent-color: var(--basalt);
  }

  .form__submit {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .form__status {
    color: var(--stone);
    font-style: italic;
  }

  .sent {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-5);
    background: var(--linen);
    border-radius: var(--radius);
  }

  .sent:focus {
    outline: none;
  }

  .sent[hidden] {
    display: none;
  }
</style>
