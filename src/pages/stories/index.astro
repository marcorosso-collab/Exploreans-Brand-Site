---
import { getEntry, getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import StoryCard from '../../components/StoryCard.astro';

const page = (await getEntry('storiesPage', 'stories'))!.data;
const places = await getCollection('places');
const placeOf = (id: string) => places.find((p) => p.id === id)?.data;
const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<Base title={page.seo_title} description={page.seo_description} navTheme="solid">
  <PageHeader title={page.title} lead={page.lead} map="a" />
  <section class="wrap stories" aria-label="All stories">
    {stories.map((story, i) => {
      const place = placeOf(story.data.place);
      return (
        <StoryCard
          story={story}
          placeName={place?.name ?? ''}
          placeKind={place?.kind ?? 'safari'}
          size={i === 0 ? 'large' : 'small'}
          headingLevel="h2"
        />
      );
    })}
  </section>
</Base>

<style>
  .stories {
    display: grid;
    gap: var(--s-6) var(--gutter);
    padding-bottom: clamp(var(--s-6), 9vw, 152px);
  }

  @media (min-width: 768px) {
    .stories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stories > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1200px) {
    .stories {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stories > :global(:nth-child(3n + 2)) {
      margin-top: var(--s-6);
    }
  }
</style>
