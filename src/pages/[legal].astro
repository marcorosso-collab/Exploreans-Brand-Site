---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate } from '../lib/format';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}

interface Props {
  page: CollectionEntry<'legal'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={`${page.data.title} | Exploreans`} description={page.data.seo_description} navTheme="solid">
  <PageHeader title={page.data.title} kicker={`Last updated ${formatDate(page.data.updated)}`} map="c" />

  <article class="wrap legal">
    <div class="legal__body">
      <Content />
    </div>
  </article>
</Base>

<script>
  // Label each table cell with its column heading, so rows can stack on small screens
  document.querySelectorAll('.legal__body table').forEach((table) => {
    const heads = [...table.querySelectorAll('th')].map((th) => th.textContent?.trim() ?? '');
    table.querySelectorAll('tbody tr').forEach((row) => {
      row.querySelectorAll('td').forEach((td, i) => td.setAttribute('data-label', heads[i] ?? ''));
    });
    table.classList.add('is-labelled');
  });
</script>

<style>
  .legal {
    padding-bottom: clamp(var(--s-6), 9vw, 136px);
  }

  .legal__body {
    max-width: 66ch;
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .legal__body > :global(p:first-child) {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .legal__body :global(p + p),
  .legal__body :global(p + ul),
  .legal__body :global(p + table),
  .legal__body :global(table + p),
  .legal__body :global(ul + p) {
    margin-top: 1.1em;
  }

  .legal__body :global(h2) {
    margin: 2em 0 0.6em;
    font-size: var(--text-subhead);
    line-height: var(--leading-subhead);
  }

  .legal__body :global(ul) {
    display: grid;
    gap: 0.4em;
    padding-left: 1.2em;
  }

  .legal__body :global(li::marker) {
    color: var(--stone);
  }

  .legal__body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--warm-ochre);
    text-underline-offset: 3px;
  }

  .legal__body :global(a:hover) {
    text-decoration-color: currentColor;
  }

  /* Tables scroll sideways on small screens rather than squeezing */
  .legal__body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-data);
    line-height: 1.5;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
    text-align: left;
    vertical-align: top;
    min-width: 14ch;
  }

  .legal__body :global(th) {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    border-bottom: 1px solid var(--hairline);
  }

  .legal__body :global(tbody tr:first-child td) {
    padding-top: var(--s-3);
  }

  /* Small screens: each row becomes a short labelled block */
  @media (max-width: 639px) {
    .legal__body :global(table.is-labelled) {
      display: block;
      overflow: visible;
    }

    .legal__body :global(table.is-labelled thead) {
      display: none;
    }

    .legal__body :global(table.is-labelled tbody),
    .legal__body :global(table.is-labelled tr) {
      display: grid;
    }

    .legal__body :global(table.is-labelled tbody) {
      gap: var(--s-4);
    }

    .legal__body :global(table.is-labelled tr) {
      gap: var(--s-2);
      padding-top: var(--s-3);
      border-top: 1px solid var(--hairline);
    }

    .legal__body :global(table.is-labelled tbody td) {
      display: grid;
      grid-template-columns: 11ch 1fr;
      gap: var(--s-3);
      padding: 0;
      min-width: 0;
    }

    .legal__body :global(table.is-labelled td::before) {
      content: attr(data-label);
      font-family: var(--font-label);
      font-size: var(--text-label);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--stone);
      padding-top: 0.2em;
    }
  }
</style>
