---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Conviction from '../components/home/Conviction.astro';
import Idea from '../components/home/Idea.astro';
import Pillars from '../components/home/Pillars.astro';
import Places from '../components/home/Places.astro';
import Families from '../components/home/Families.astro';
import Passport from '../components/home/Passport.astro';
import Moment from '../components/home/Moment.astro';
import Stories from '../components/home/Stories.astro';

const home = (await getEntry('home', 'home'))!.data;
---
<Base title={home.seo_title} description={home.seo_description} navTheme="overlay">
  <link slot="head" rel="preload" as="image" href={home.hero.poster} fetchpriority="high" />
  <Hero />
  <Conviction />
  <Idea />
  <Pillars />
  <Places />
  <Families />
  <Passport />
  <Moment />
  <Stories />
</Base>
